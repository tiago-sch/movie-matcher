# Required — get yours at https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=

# Optional — defaults to gpt-4o-mini
VITE_OPENAI_MODEL=

# Optional — reCAPTCHA v2 checkbox site key (https://www.google.com/recaptcha/admin)
# Must be a v2 "I'm not a robot" checkbox key; v3/Enterprise keys fail with "invalid key type"
VITE_RECAPTCHA_SITE_KEY=

# Optional — get yours at https://www.themoviedb.org/settings/api
# Without this, movie cards show without poster images
VITE_TMDB_API_KEY=
