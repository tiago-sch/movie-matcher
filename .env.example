# --- Server-side (Vercel env vars, never exposed to the browser) ---
# Required — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional — defaults to gpt-4o-mini
OPENAI_MODEL=
# Required — reCAPTCHA Enterprise (score-based key) verification
# Google Cloud project that owns the reCAPTCHA key
GCP_PROJECT_ID=
# Google Cloud API key with access to the reCAPTCHA Enterprise API
RECAPTCHA_API_KEY=
# The same site key as VITE_RECAPTCHA_SITE_KEY below
RECAPTCHA_SITE_KEY=
# Optional — minimum score (0.0–1.0) to accept, defaults to 0.5
RECAPTCHA_MIN_SCORE=

# --- Client-side (bundled into the browser build) ---
# Required — reCAPTCHA Enterprise score-based site key
VITE_RECAPTCHA_SITE_KEY=
# Optional — get yours at https://www.themoviedb.org/settings/api
# Without this, movie cards show without poster images
VITE_TMDB_API_KEY=
