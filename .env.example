# --- Server-side (Vercel env vars, never exposed to the browser) ---
# Required — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional — defaults to gpt-4o-mini
OPENAI_MODEL=
# Required — Cloudflare Turnstile secret key (dash.cloudflare.com → Turnstile)
TURNSTILE_SECRET_KEY=
# Optional — comma-separated hostnames allowed to call the API (checked against the
# request Origin and the hostname where Turnstile was solved). The current Vercel
# deployment URL is always allowed. Defaults to feelpick.com, www.feelpick.com, localhost, 127.0.0.1
ALLOWED_HOSTNAMES=
# Optional — Firebase service account JSON (Project settings → Service accounts →
# Generate new private key), pasted as-is. Enables shareable links and "My feels".
# Without it, results still work but are not saved.
FIREBASE_SERVICE_ACCOUNT=

# --- Client-side (bundled into the browser build) ---
# Required — Cloudflare Turnstile site key
VITE_TURNSTILE_SITE_KEY=
# Optional — get yours at https://www.themoviedb.org/settings/api
# Without this, movie cards show without poster images
VITE_TMDB_API_KEY=
# Optional — Firebase web app config (Project settings → Your apps → Web). Enables Google sign-in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
